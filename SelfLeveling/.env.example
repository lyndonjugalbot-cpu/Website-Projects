# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). Both are safe in client code — row level
# security is what protects the data. Never add the service_role key.
#
# Without these the app runs local-only (no accounts, no cross-device sync).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJ...
