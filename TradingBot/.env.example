# Copy this file to .env and fill in your own values.
# .env is git-ignored -- never commit real keys.

# Create these at https://www.binance.com/en/my/settings/api-management
# with "Enable Trading" checked and "Enable Withdrawals" LEFT UNCHECKED.
# See README.md for the full walkthrough.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Master safety switch. true = paper trading (default, no real orders).
# Setting this to false is only HALF of what's needed to go live -- you
# also need to pass --live on the command line. See main.py.
PAPER=true

# Binance's spot testnet (https://testnet.binance.vision/) uses separate
# keys from mainnet. Recommended for your first live-code dry run before
# ever setting PAPER=false against a real account.
USE_TESTNET=true
