// Prisma schema for Seoul Stop Kmart.
// Postgres (e.g. Neon, provisioned via Vercel's Storage tab) — see README
// "Deploying to Vercel". Originally built against SQLite for local-demo
// simplicity; migration history before 20260817 was written for SQLite and
// squashed into a single Postgres-native init migration when switching, so
// `prisma migrate deploy` on a fresh Postgres database applies cleanly.
//
// Prisma 7 generates the client as TypeScript source into ./generated/prisma
// (gitignored, regenerated via `npm run postinstall` / `prisma generate`) and
// no longer reads the connection string from this file. The URL is supplied
// at runtime via a driver adapter — see lib/prisma.ts — and to the CLI via
// prisma.config.ts (for `prisma migrate` / `prisma studio`).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER   // full access, incl. staff/user management
  MANAGER // product + order management
  STAFF   // view/process orders only
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ProductCategory {
  SNACKS
  BEVERAGES
  INSTANT_NOODLES
  FROZEN_FOOD
  FRESH_GROCERY
  SAUCES_CONDIMENTS
  BEAUTY_PERSONAL_CARE
  HOUSEHOLD
  KITCHENWARE
  OTHER
}

enum ProductStatus {
  ACTIVE       // visible and purchasable (subject to stock)
  INACTIVE     // hidden from the storefront entirely
  OUT_OF_STOCK // visible, but not purchasable regardless of stock count
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  // Prices stored in centavos (PHP cents) as integers to avoid floating
  // point rounding errors. Divide by 100 to display pesos.
  priceCentavos     Int
  salePriceCentavos Int?
  // Purchase cost / cost of goods sold, in centavos. Never exposed via any
  // public/storefront API — admin- and reports-only. Optional since not
  // every seed/demo product will have real cost data entered yet.
  costCentavos      Int?
  supplier          String?
  // Unique barcode/SKU for POS lookup (hardware scanners emit this as
  // keystrokes). Optional — not every product needs one.
  barcode           String?         @unique
  imageUrl          String
  stock             Int             @default(0)
  // Below this quantity, the product surfaces in the admin "low stock" view.
  lowStockThreshold Int             @default(5)
  // When false (default), stock can never go negative — POS/online sales
  // are rejected once stock hits 0. An admin can flip this per-product to
  // explicitly allow overselling (e.g. made-to-order items).
  allowOversell     Boolean         @default(false)
  category          ProductCategory @default(OTHER)
  status            ProductStatus   @default(ACTIVE)
  isFeatured        Boolean         @default(false)
  isBestSeller      Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]
}

// Fulfillment pipeline — tracked separately from PaymentStatus below, since
// an order can be CONFIRMED and PREPARING while payment is still PENDING
// (e.g. cash on delivery).
enum OrderStatus {
  PENDING             // order created, awaiting staff confirmation
  CONFIRMED           // staff confirmed the order
  PREPARING           // being packed/prepared
  READY_FOR_DELIVERY  // packed, awaiting rider/dispatch
  OUT_FOR_DELIVERY    // with the rider
  COMPLETED           // delivered / picked up
  CANCELLED
}

// Tracked independently of OrderStatus. Only ever set to PAID by
// server-side code that has verified payment with a real provider (PayMongo
// webhook/poll) or, for COD/bank transfer, by a staff member who manually
// confirms funds were actually received — never implied by order progress.
enum PaymentStatus {
  PENDING   // not yet paid / awaiting the customer's payment action
  PROCESSING // payment attempt in progress (e.g. redirected to gateway)
  PAID
  FAILED
  REFUNDED
}

enum SalesChannel {
  ONLINE // storefront checkout
  POS    // in-store, rung up by staff
}

model Order {
  id    String       @id @default(cuid())
  channel SalesChannel @default(ONLINE)

  // Required for ONLINE (delivery) orders; null for walk-in POS sales.
  // Validated at the application layer per-channel — see lib/orders.ts /
  // lib/pos.ts — since Prisma can't express "required unless POS".
  customerName String?
  email        String?
  phone        String?

  // Cebu delivery address, broken out for legibility on the admin side and
  // for riders/dispatch — see README for why this isn't just one field.
  // Null for POS sales (no delivery).
  addressLine  String?
  barangay     String?
  city         String?
  province     String?
  postalCode   String?
  deliveryNotes String?

  subtotalCentavos    Int
  deliveryFeeCentavos Int @default(0)
  discountCentavos    Int @default(0)
  totalCentavos       Int

  orderStatus   OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // PayMongo (or mock) payment intent tracking — null for COD/bank transfer/POS.
  paymentIntentId String? @unique
  // "gcash" | "paymaya" | "card" | "cod" | "bank_transfer" | "cash"
  paymentMethod   String?
  isMockPayment   Boolean @default(false)

  // POS-only fields — null for ONLINE orders.
  cashierId            String?
  cashierName          String? // snapshot, survives the User being edited/deactivated
  cashReceivedCentavos Int?
  changeGivenCentavos  Int?
  voidedAt             DateTime?
  voidedByName         String?
  voidReason           String?

  // Lightweight internal note + attribution, editable by staff/manager/owner.
  internalNotes      String?
  lastUpdatedByName  String?

  items          OrderItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  // Snapshot fields so order history — and profit reports — stay accurate
  // even if the product is later repriced, recosted, or deleted.
  productName       String
  unitPriceCentavos Int
  // Cost snapshot at time of sale. Null if the product had no cost entered
  // yet — reports treat null cost as "unknown", not zero, so margin figures
  // aren't silently inflated.
  unitCostCentavos  Int?
  quantity          Int
  subtotalCentavos  Int
}

enum StockMovementType {
  ONLINE_SALE
  POS_SALE
  RESTOCK
  MANUAL_ADJUSTMENT
  RETURN
  CANCELLATION
  REFUND
}

// Append-only audit trail — every stock change writes exactly one row here.
// Product.stock is a derived cache of "sum of all movements"; this table is
// the source of truth for "what happened and why."
model StockMovement {
  id             String            @id @default(cuid())
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  previousStock  Int
  quantityChange Int // signed: negative for sales/deductions, positive for restocks/returns
  newStock       Int
  type           StockMovementType
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?
  userName       String? // snapshot of who made the change; null for system/webhook-triggered
  note           String?
  createdAt      DateTime          @default(now())

  @@index([productId])
  @@index([orderId])
}

// Admin-entered operating expenses, used for net profit/loss in Reports.
model Expense {
  id              String   @id @default(cuid())
  date            DateTime
  category        String
  amountCentavos  Int
  note            String?
  createdByName   String?
  createdAt       DateTime @default(now())
}
