# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real secrets.

# --- Database ---------------------------------------------------------
# Postgres connection string. Get one for free from Neon, Supabase, or by
# adding a Postgres store to your Vercel project (Storage tab) — see
# README "Deploying to Vercel". Same format for local dev and production;
# use a separate database for each so local testing never touches real data.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- PayMongo (sandbox/test keys) --------------------------------------
# Get these from the PayMongo Dashboard (https://dashboard.paymongo.com)
# after creating a free account:
#   1. Sign up / log in.
#   2. Make sure you're in "Test mode" (toggle top-left of the dashboard).
#   3. Go to Developers > API Keys.
#   4. Copy the "Secret key" and "Public key" (both start with sk_test_ / pk_test_).
#
# If these are left blank, the app automatically falls back to a MOCK
# payment flow (see lib/paymongo.ts) so the site stays fully demoable
# without a real PayMongo account.
PAYMONGO_SECRET_KEY=""
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=""

# Webhook signing secret, shown when you register a webhook endpoint in
# the PayMongo Dashboard (Developers > Webhooks). Used to verify that
# incoming requests to /api/webhooks/paymongo genuinely came from PayMongo.
PAYMONGO_WEBHOOK_SECRET=""

# Public base URL of this app, used to build PayMongo redirect URLs
# (e.g. after a GCash/Maya payment). Update for production deployments.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin authentication (NextAuth) -----------------------------------
# Random secret used to sign admin session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
# Must match the URL the app is served from (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# --- Initial admin account (used only by prisma/seed.ts) ---------------
# Creates one OWNER account the first time you run `npm run db:seed`.
# Change this password immediately after your first login.
SEED_ADMIN_EMAIL="owner@seoulstopkmart.ph"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Product image storage (Vercel Blob) --------------------------------
# Auto-filled by Vercel when you add a Blob store to this project (Storage
# tab in the Vercel dashboard) — no manual value needed there. For local
# dev, run `vercel env pull .env` after connecting the project, or create
# a Blob store token manually in the dashboard and paste it here.
BLOB_READ_WRITE_TOKEN=""
