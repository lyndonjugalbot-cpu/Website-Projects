// Prisma schema for Seoul Stop Kmart.
// Postgres (e.g. Neon, provisioned via Vercel's Storage tab) — see README
// "Deploying to Vercel". Originally built against SQLite for local-demo
// simplicity; migration history before 20260817 was written for SQLite and
// squashed into a single Postgres-native init migration when switching, so
// `prisma migrate deploy` on a fresh Postgres database applies cleanly.
//
// Prisma 7 generates the client as TypeScript source into ./generated/prisma
// (gitignored, regenerated via `npm run postinstall` / `prisma generate`) and
// no longer reads the connection string from this file. The URL is supplied
// at runtime via a driver adapter — see lib/prisma.ts — and to the CLI via
// prisma.config.ts (for `prisma migrate` / `prisma studio`).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER   // full access, incl. staff/user management
  MANAGER // product + order management
  STAFF   // view/process orders only
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee?
}

enum ProductCategory {
  SNACKS
  BEVERAGES
  INSTANT_NOODLES
  FROZEN_FOOD
  FRESH_GROCERY
  SAUCES_CONDIMENTS
  BEAUTY_PERSONAL_CARE
  HOUSEHOLD
  KITCHENWARE
  OTHER
}

enum ProductStatus {
  ACTIVE       // visible and purchasable (subject to stock)
  INACTIVE     // hidden from the storefront entirely
  OUT_OF_STOCK // visible, but not purchasable regardless of stock count
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  // Prices stored in centavos (PHP cents) as integers to avoid floating
  // point rounding errors. Divide by 100 to display pesos.
  priceCentavos     Int
  salePriceCentavos Int?
  // Purchase cost / cost of goods sold, in centavos. Never exposed via any
  // public/storefront API — admin- and reports-only. Optional since not
  // every seed/demo product will have real cost data entered yet.
  costCentavos      Int?
  supplier          String?
  // Unique barcode/SKU for POS lookup (hardware scanners emit this as
  // keystrokes). Optional — not every product needs one.
  barcode           String?         @unique
  // Extra scannable codes for the same product (some items ship with more
  // than one barcode). The POS matches these as well as `barcode`.
  altBarcodes       String[]        @default([])
  // The store's own product group from the POS import (e.g. "Ramen",
  // "Soju", "Toys") — finer-grained than the storefront `category` enum,
  // and used for the group filter on the register screen.
  groupName         String?
  // True for in-store-only items (services, cups, takeout boxes…) that
  // must never appear on, or be bought through, the online storefront.
  posOnly           Boolean         @default(false)
  imageUrl          String
  stock             Int             @default(0)
  // Below this quantity, the product surfaces in the admin "low stock" view.
  lowStockThreshold Int             @default(5)
  // When false (default), stock can never go negative — POS/online sales
  // are rejected once stock hits 0. An admin can flip this per-product to
  // explicitly allow overselling (e.g. made-to-order items).
  allowOversell     Boolean         @default(false)
  category          ProductCategory @default(OTHER)
  status            ProductStatus   @default(ACTIVE)
  isFeatured        Boolean         @default(false)
  isBestSeller      Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]
}

// Fulfillment pipeline — tracked separately from PaymentStatus below, since
// an order can be CONFIRMED and PREPARING while payment is still PENDING
// (e.g. cash on delivery).
enum OrderStatus {
  PENDING             // order created, awaiting staff confirmation
  CONFIRMED           // staff confirmed the order
  PREPARING           // being packed/prepared
  READY_FOR_DELIVERY  // packed, awaiting rider/dispatch
  OUT_FOR_DELIVERY    // with the rider
  COMPLETED           // delivered / picked up
  CANCELLED
}

// Tracked independently of OrderStatus. Only ever set to PAID by
// server-side code that has verified payment with a real provider (PayMongo
// webhook/poll) or, for COD/bank transfer, by a staff member who manually
// confirms funds were actually received — never implied by order progress.
enum PaymentStatus {
  PENDING   // not yet paid / awaiting the customer's payment action
  PROCESSING // payment attempt in progress (e.g. redirected to gateway)
  PAID
  FAILED
  REFUNDED
}

enum SalesChannel {
  ONLINE // storefront checkout
  POS    // in-store, rung up by staff
}

model Order {
  id    String       @id @default(cuid())
  channel SalesChannel @default(ONLINE)

  // Required for ONLINE (delivery) orders; null for walk-in POS sales.
  // Validated at the application layer per-channel — see lib/orders.ts /
  // lib/pos.ts — since Prisma can't express "required unless POS".
  customerName String?
  email        String?
  phone        String?

  // Cebu delivery address, broken out for legibility on the admin side and
  // for riders/dispatch — see README for why this isn't just one field.
  // Null for POS sales (no delivery).
  addressLine  String?
  barangay     String?
  city         String?
  province     String?
  postalCode   String?
  deliveryNotes String?

  subtotalCentavos    Int
  deliveryFeeCentavos Int @default(0)
  discountCentavos    Int @default(0)
  totalCentavos       Int

  orderStatus   OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // PayMongo (or mock) payment intent tracking — null for COD/bank transfer/POS.
  paymentIntentId String? @unique
  // "gcash" | "paymaya" | "card" | "cod" | "bank_transfer" | "cash" | "split"
  // ("split" = in-store sale paid partly in cash, partly by GCash).
  paymentMethod   String?
  isMockPayment   Boolean @default(false)

  // POS-only fields — null for ONLINE orders.
  cashierId            String?
  cashierName          String? // snapshot, survives the User being edited/deactivated
  cashReceivedCentavos Int?
  changeGivenCentavos  Int?
  // Split payments only: the part paid by GCash. The rest of the total was
  // paid in cash (cashReceivedCentavos / changeGivenCentavos cover that part).
  gcashAmountCentavos  Int?
  voidedAt             DateTime?
  voidedByName         String?
  voidReason           String?

  // Loyalty points (see lib/loyalty.ts). A member's points are earned on the
  // sale total after every discount, and redeemed as a peso discount — the
  // redeemed value is included in discountCentavos and also kept separately
  // here so the receipt can show it on its own line.
  customer              Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId            String?
  pointsEarned          Int       @default(0)
  pointsRedeemed        Int       @default(0)
  pointsDiscountCentavos Int      @default(0)
  pointsBalanceAfter    Int?
  pointsTransactions    PointsTransaction[]

  // Money handed back so far by refunds (see Refund below). A partially
  // refunded sale stays PAID; once every item is refunded it flips to REFUNDED.
  refundedCentavos Int      @default(0)
  refunds          Refund[]

  // Lightweight internal note + attribution, editable by staff/manager/owner.
  internalNotes      String?
  lastUpdatedByName  String?

  items          OrderItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  // Snapshot fields so order history — and profit reports — stay accurate
  // even if the product is later repriced, recosted, or deleted.
  productName       String
  unitPriceCentavos Int
  // Cost snapshot at time of sale. Null if the product had no cost entered
  // yet — reports treat null cost as "unknown", not zero, so margin figures
  // aren't silently inflated.
  unitCostCentavos  Int?
  quantity          Int
  subtotalCentavos  Int
  // Units of this line handed back through refunds (never more than quantity).
  refundedQuantity  Int      @default(0)
}

enum StockMovementType {
  ONLINE_SALE
  POS_SALE
  RESTOCK
  MANUAL_ADJUSTMENT
  RETURN
  CANCELLATION
  REFUND
}

// Append-only audit trail — every stock change writes exactly one row here.
// Product.stock is a derived cache of "sum of all movements"; this table is
// the source of truth for "what happened and why."
model StockMovement {
  id             String            @id @default(cuid())
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  previousStock  Int
  quantityChange Int // signed: negative for sales/deductions, positive for restocks/returns
  newStock       Int
  type           StockMovementType
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?
  userName       String? // snapshot of who made the change; null for system/webhook-triggered
  note           String?
  createdAt      DateTime          @default(now())

  @@index([productId])
  @@index([orderId])
}

// A refund on an in-store sale, processed by a manager/owner only (see
// refundPosSale in lib/pos.ts). Refunded items go back into stock, and the
// money comes out of the refunding person's drawer (cash or GCash), so it
// lowers their expected balance at close (lib/shifts.ts).
model Refund {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  amountCentavos Int
  // Drawer the money was paid back from: "cash" or "gcash".
  method         String
  reason         String
  // What was handed back, e.g. [{ orderItemId, productName, quantity }].
  items          Json
  refundedById   String
  refundedByName String
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([refundedById, createdAt])
  @@index([createdAt])
}

// Admin-entered operating expenses, used for net profit/loss in Reports.
// Also doubles as the "record a receipt" feature — receiptName holds the
// name on the physical/digital receipt being logged (e.g. a supplier
// invoice), while category keeps its existing grouping role for reports.
model Expense {
  id              String   @id @default(cuid())
  date            DateTime
  category        String
  receiptName     String?
  amountCentavos  Int
  note            String?
  createdByName   String?
  createdAt       DateTime @default(now())
}

// Admin-maintained employee roster, used to compute pay and generate
// payslips. Employees are deactivated (isActive = false) rather than
// deleted, same pattern as User, so payslip history stays intact.
model Employee {
  id                String   @id @default(cuid())
  name              String
  position          String?
  dailyRateCentavos Int
  isActive          Boolean  @default(true)
  // Optional link to this person's staff login, so payslips can pull their
  // clocked hours from TimeEntry. Unlinked employees are paid on manually
  // entered hours as before.
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payslips Payslip[]
}

// One generated payslip for one employee covering one pay period. Daily
// rate and employee identity are snapshotted at generation time so a
// payslip stays accurate even if the employee record later changes.
// regularPayCentavos = (dailyRateCentavos / STANDARD_HOURS_PER_DAY) *
// hoursWorked — see lib/payroll.ts for the shared computation.
model Payslip {
  id                 String   @id @default(cuid())
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId         String
  employeeName       String
  position           String?
  periodStart        DateTime
  periodEnd          DateTime
  dailyRateCentavos  Int
  hoursWorked        Float
  regularPayCentavos Int
  // Manual line items on top of regular pay — holiday bonuses (computed as
  // a % of the daily rate at generation time) plus admin-entered bonuses/
  // deductions, e.g. [{ label: "Holiday: Christmas Day (200%)",
  // amountCentavos: 120000 }, { label: "Cash advance", amountCentavos: -20000 }].
  // Negative amounts are deductions, positive are bonuses/allowances.
  adjustments        Json
  netPayCentavos     Int
  generatedByName    String?
  createdAt          DateTime @default(now())

  @@index([employeeId])
}

// One shift on the time clock. clockOut/hoursWorked stay null while the
// person is still clocked in. hoursWorked is computed once, at time-out
// (or when a manager corrects the entry), and is what payslips sum.
model TimeEntry {
  id           String    @id @default(cuid())
  userId       String
  userName     String // snapshot, survives the User being edited/deactivated
  clockIn      DateTime  @default(now())
  clockOut     DateTime?
  hoursWorked  Float?
  note         String?
  // Set when a manager manually creates/corrects the entry.
  editedByName String?
  createdAt    DateTime  @default(now())

  @@index([userId, clockIn])
  @@index([clockIn])
}

// A cashier's till count for one shift: what was in the drawer and in GCash
// when they started, and what they counted when they finished. At close the
// system snapshots what it *expected* (opening + that cashier's cash/GCash
// POS sales since opening) so the variance is fixed in time.
model CashSession {
  id                      String    @id @default(cuid())
  userId                  String
  cashierName             String
  openedAt                DateTime  @default(now())
  openingCashCentavos     Int
  openingGcashCentavos    Int
  closedAt                DateTime?
  closingCashCentavos     Int?
  closingGcashCentavos    Int?
  expectedCashCentavos    Int?
  expectedGcashCentavos   Int?
  note                    String?
  createdAt               DateTime  @default(now())

  @@index([userId, openedAt])
  @@index([openedAt])
}

// Supplier delivery receipts logged by staff (ported from SSKReceiptTracker):
// a receipt name, an amount and a date. These are stock purchases — the
// cost is already counted in profit through each product's cost when it
// sells — so they are deliberately NOT subtracted from profit again.
model DeliveryReceipt {
  id             String   @id @default(cuid())
  receiptName    String
  receiptNumber  String?
  amountCentavos Int
  date           DateTime
  note           String?
  createdByName  String?
  createdAt      DateTime @default(now())

  @@index([date])
}

enum BillRecurrence {
  NONE
  MONTHLY
}

// A bill to pay (rent, electricity, loan instalment…). Shown on the bills
// calendar and flagged in the admin once it is within reminderDaysBefore of
// its due date. Paid bills count as operating expenses in profit, dated by
// paidAt. Marking a MONTHLY bill paid creates next month's bill.
model Bill {
  id                 String         @id @default(cuid())
  name               String
  amountCentavos     Int
  dueDate            DateTime
  recurrence         BillRecurrence @default(NONE)
  reminderDaysBefore Int            @default(3)
  isPaid             Boolean        @default(false)
  paidAt             DateTime?
  paidAmountCentavos Int?
  paidByName         String?
  note               String?
  createdByName      String?
  createdAt          DateTime       @default(now())

  @@index([dueDate])
  @@index([paidAt])
}


// A loyalty-program member, identified by mobile number. Customers check
// their points on the website with phone number + PIN; the PIN is generated
// at sign-up, shown to the cashier once, and only its hash is stored.
model Customer {
  id                String    @id @default(cuid())
  name              String
  // Normalised to +639XXXXXXXXX — see normalizePhone() in lib/loyalty-math.ts.
  phone             String    @unique
  pinHash           String
  points            Int       @default(0)
  lifetimePoints    Int       @default(0)
  // Public balance lookups lock for a while after repeated wrong PINs.
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  createdByName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders       Order[]
  transactions PointsTransaction[]
}

enum PointsTransactionType {
  EARN
  REDEEM
  ADJUST      // manual correction by a manager/owner
  VOID_EARN   // points taken back when a sale is voided
  VOID_REDEEM // points given back when a sale is voided
}

// Append-only points ledger; Customer.points is the running total of it.
model PointsTransaction {
  id           String                @id @default(cuid())
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  type         PointsTransactionType
  points       Int // signed: positive adds to the balance, negative takes away
  balanceAfter Int
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId      String?
  note         String?
  userName     String?
  createdAt    DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
}


// Money taken out of the register at the POS — salary, cash advances (CA),
// bills payment, supplies and so on. It lowers the drawer's expected balance
// (lib/shifts.ts); categories flagged as expenses in lib/cashout-config.ts
// also count toward operating costs in Reports/Profit (lib/profit.ts).
model CashOut {
  id             String    @id @default(cuid())
  cashierId      String
  cashierName    String
  // Key from CASH_OUT_CATEGORIES in lib/cashout-config.ts (SALARY, CASH_ADVANCE, …).
  category       String
  // Who or what it was for, e.g. an employee's name or "VECO bill".
  payee          String?
  amountCentavos Int
  // Which drawer the money came out of: "cash" or "gcash".
  paidFrom       String    @default("cash")
  note           String?
  voidedAt       DateTime?
  voidedByName   String?
  voidReason     String?
  createdAt      DateTime  @default(now())

  @@index([cashierId, createdAt])
  @@index([createdAt])
}

// A store computer the owner has approved for staff sign-in. The browser holds
// a secret random key in an httpOnly cookie; only its SHA-256 hash is stored
// here. STAFF logins are refused from any browser without an active key (see
// lib/pos-device.ts). Owners and managers can sign in from anywhere.
model PosDevice {
  id             String    @id @default(cuid())
  name           String
  tokenHash      String    @unique
  approvedByName String
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime?
  revokedAt      DateTime?
}
