// Wots TCG Vault NZ — database schema
// Postgres + Prisma. Soft deletion via `deletedAt` on user-facing records.
// Every model that holds money, identity data, or moderation state carries
// createdAt/updatedAt for audit purposes; sensitive tables are additionally
// mirrored into AuditLog on write (see lib/audit.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth) + Roles/Permissions
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  MODERATOR
  VERIFICATION_REVIEWER
  SUPPORT
  SUPER_ADMIN
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "listings.approve", "users.ban"
  description String
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@unique([role, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  purpose    String // "email-verify" | "password-reset"

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Users / Profiles
// ---------------------------------------------------------------------------

model User {
  id             String  @id @default(cuid())
  fullName       String
  username       String  @unique
  displayName    String?
  email          String  @unique
  emailVerified  DateTime?
  passwordHash   String? // null for OAuth-only accounts
  role           Role    @default(BUYER)

  // Profile
  avatarUrl   String?
  bio         String?  @db.Text
  location    String? // NZ region/city, self-reported
  joinedAt    DateTime @default(now())

  // Two-factor auth
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Verification badges (denormalized flags for fast reads; source of truth
  // is EmailVerification / FacebookConnection / IdentityVerification below)
  isEmailVerified    Boolean @default(false)
  isFacebookLinked   Boolean @default(false)
  isIdVerified       Boolean @default(false)
  isTrustedSeller    Boolean @default(false)

  acceptedTermsAt   DateTime?
  acceptedPrivacyAt DateTime?
  sellerTermsAt     DateTime?

  status        UserStatus @default(ACTIVE)
  bannedReason  String?
  bannedAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts Account[]
  sessions Session[]

  facebookConnection  FacebookConnection?
  identityVerification IdentityVerification[]

  listings      Listing[]
  collections   Collection[]

  ordersAsBuyer  Order[] @relation("BuyerOrders")

  payoutAccount SellerPayoutAccount?
  payouts       Payout[]
  transfers     Transfer[]

  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewSubject")

  favorites     Favorite[]
  favoriteSellers FavoriteSeller[] @relation("FollowerUser")
  followedBy      FavoriteSeller[] @relation("FollowedSeller")

  notifications Notification[]

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsReceived Report[] @relation("ReportsReceived")

  conversationsA Conversation[] @relation("ParticipantA")
  conversationsB Conversation[] @relation("ParticipantB")
  messagesSent   Message[]      @relation("MessageSender")

  blockedUsers UserBlock[] @relation("Blocker")
  blockedBy    UserBlock[] @relation("Blocked")

  auditLogs AuditLog[] @relation("AuditActor")

  disputesFiled Dispute[] @relation("DisputeFiledBy")

  aiConversations AiConversation[]

  @@index([role])
  @@index([status])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

model FacebookConnection {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @unique
  facebookUserId  String   @unique
  profileUrl      String
  connectedAt     DateTime @default(now())
  // Consent gate: profileUrl is only rendered on the public profile when true.
  publicConsent   Boolean  @default(false)
  consentUpdatedAt DateTime?
}

// ---------------------------------------------------------------------------
// Identity Verification (KYC)
// ---------------------------------------------------------------------------

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMISSION_REQUESTED
}

model IdentityVerification {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  status         VerificationStatus @default(PENDING)
  documentType   String // "drivers_license" | "passport" | "nz_id"
  // Encrypted-at-rest object storage key, never a public URL. Access is
  // brokered through a short-lived signed URL generated server-side for
  // reviewers only — see lib/verification.ts.
  documentFrontKey String
  documentBackKey  String?
  selfieKey        String?

  reviewerNotes  String?  @db.Text
  reviewedBy     String?
  reviewedAt     DateTime?

  submittedAt DateTime  @default(now())
  // Documents are purged automatically once no longer required for
  // compliance retention — see docs/LEGAL.md.
  purgeAfter  DateTime?
  purgedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Catalog: Categories / Conditions / Grading
// ---------------------------------------------------------------------------

enum ListingCategory {
  SINGLE_CARD
  GRADED_SLAB
  SEALED_PRODUCT
  BOOSTER_BOX
  BOOSTER_PACK
  ELITE_TRAINER_BOX
  COLLECTION
  ACCESSORIES
  OTHER
}

enum ItemCondition {
  MINT
  NEAR_MINT
  EXCELLENT
  GOOD
  PLAYED
  HEAVILY_PLAYED
  DAMAGED
}

enum GradingCompany {
  PSA
  BGS
  CGC
  ACE
  OTHER
}

enum CardLanguage {
  ENGLISH
  JAPANESE
  KOREAN
  CHINESE
  GERMAN
  FRENCH
  ITALIAN
  SPANISH
  OTHER
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD
  REMOVED
  REJECTED
}

model Listing {
  id       String @id @default(cuid())
  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  title       String
  slug        String  @unique
  category    ListingCategory
  setName     String?
  cardNumber  String?
  language    CardLanguage @default(ENGLISH)

  priceCents  Int // NZD, minor units
  quantity    Int @default(1)
  // Units currently held by an in-flight checkout (see ListingReservation).
  // Buyable quantity for a new checkout is (quantity - reservedQuantity),
  // enforced atomically at reservation time — see lib/reservations.ts.
  reservedQuantity Int @default(0)
  condition   ItemCondition?
  description String @db.Text

  // Raw card defect disclosures (self-reported by seller)
  defectWhiteningBack    Boolean @default(false)
  defectWhiteningCorners Boolean @default(false)
  defectScratches        Boolean @default(false)
  defectDents            Boolean @default(false)
  defectCreases          Boolean @default(false)
  defectSurfaceDamage    Boolean @default(false)
  defectPrintLines       Boolean @default(false)
  defectEdgeWear         Boolean @default(false)
  defectBends            Boolean @default(false)
  defectWaterDamage      Boolean @default(false)
  defectOtherNotes       String? @db.Text

  // Grading (for GRADED_SLAB)
  gradingCompany     GradingCompany?
  grade              String?
  certificationNumber String?
  slabDamageNotes    String? @db.Text

  isAuthenticityDeclared Boolean @default(false)

  country     String @default("New Zealand")
  region      String?
  offersPickup Boolean @default(false)
  offersDelivery Boolean @default(true)
  shippingOptions ShippingOption[]

  returnPolicy String? @db.Text
  videoUrl     String?

  status        ListingStatus @default(DRAFT)
  rejectionNote String?
  viewCount     Int @default(0)
  favoriteCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  publishedAt DateTime?
  soldAt      DateTime?
  deletedAt   DateTime?

  images    ListingImage[]
  favorites Favorite[]
  orderItems OrderItem[]
  reports   Report[] @relation("ReportedListing")
  messages  Message[] @relation("MessageListingRef")
  reservations ListingReservation[]

  @@index([category])
  @@index([status])
  @@index([sellerId])
  @@index([priceCents])
  @@index([createdAt])
}

model ShippingOption {
  id          String  @id @default(cuid())
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
  name        String // "NZ Post Tracked", "Courier", "Local Pickup"
  priceCents  Int
  region      String? // null = nationwide
  hasInsurance Boolean @default(false)

  @@index([listingId])
}

model ListingImage {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  url       String
  angle     ImageAngle @default(ADDITIONAL)
  position  Int     @default(0)
  isWatermarked Boolean @default(false)
  moderationStatus ModerationStatus @default(PENDING)

  @@index([listingId])
}

enum ImageAngle {
  FRONT
  BACK
  SIDE
  ADDITIONAL
}

enum ModerationStatus {
  PENDING
  APPROVED
  FLAGGED
}

// ---------------------------------------------------------------------------
// Collections (user showcases)
// ---------------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  name        String
  description String?  @db.Text
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CollectionItem[]

  @@index([ownerId])
}

model CollectionItem {
  id              String     @id @default(cuid())
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId    String
  name            String
  setName         String?
  category        ListingCategory
  condition       ItemCondition?
  images          String[]
  gradingCompany  GradingCompany?
  grade           String?
  estimatedValueCents Int?
  notes           String? @db.Text
  isPublic        Boolean @default(true)
  createdAt       DateTime @default(now())

  @@index([collectionId])
}

// ---------------------------------------------------------------------------
// Orders / Payments / Payouts / Refunds / Disputes
// ---------------------------------------------------------------------------

// Full order state machine. Renamed PAYMENT_PENDING -> PENDING_PAYMENT and
// added the intermediate states needed for delayed-payout tracking
// (INSPECTION_PERIOD, PAYOUT_ELIGIBLE, PAYOUT_PENDING) plus failure/review
// states (DELIVERY_FAILED, ADMIN_REVIEW) so stalled orders surface to staff
// instead of silently never completing.
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  AWAITING_SHIPMENT
  SHIPPED
  IN_TRANSIT
  DELIVERED
  INSPECTION_PERIOD
  PAYOUT_ELIGIBLE
  PAYOUT_PENDING
  COMPLETED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  DELIVERY_FAILED
  ADMIN_REVIEW
}

model Order {
  id       String @id @default(cuid())
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId  String

  status OrderStatus @default(PENDING_PAYMENT)

  subtotalCents      Int
  shippingCents      Int @default(0)
  platformFeeCents   Int @default(0)
  processingFeeCents Int @default(0)
  totalCents         Int

  shippingName    String
  shippingAddress1 String
  shippingAddress2 String?
  shippingSuburb   String?
  shippingCity     String
  shippingPostcode String
  shippingCountry  String @default("New Zealand")
  shippingMethod   String?

  // Legacy field, kept so existing data/queries referencing it don't break;
  // superseded by inspectionEndAt for the new delivery-based inspection
  // window, but still used as a hard backstop if delivery is never
  // confirmed at all (see lib/orders.ts sweepStaleOrders).
  deliveryConfirmDeadline DateTime?
  paidAt                  DateTime?
  deliveredAt             DateTime?
  // Buyer protection / inspection period — starts when delivery is
  // confirmed (by tracking, admin, or buyer) and ends inspectionEndAt.
  // No dispute open by then => order becomes PAYOUT_ELIGIBLE.
  inspectionStartAt       DateTime?
  inspectionEndAt         DateTime?
  payoutEligibleAt        DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  // Set when a SHIPPED order goes stale with no delivery confirmation for
  // too long (see PlatformFeeSetting.maxDeliveryWaitDays) — surfaces to
  // admin rather than silently auto-completing or auto-cancelling.
  deliveryFailedAt         DateTime?
  adminReviewNote          String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       OrderItem[]
  payment     Payment?
  shipment    ShippingRecord?
  refunds     Refund[]
  dispute     Dispute?
  reviews     Review[]
  reservation ListingReservation?
  transfers   Transfer[]

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  listing      Listing @relation(fields: [listingId], references: [id])
  listingId    String
  sellerId     String
  titleSnapshot String
  priceCents   Int
  quantity     Int @default(1)

  @@index([orderId])
  @@index([listingId])
}

enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
  CHARGEBACK
}

model Payment {
  id       String  @id @default(cuid())
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String  @unique

  provider                 String  @default("stripe")
  // Separate-charges-and-transfers model: the charge settles on the
  // platform's own Stripe account (no transfer_data at creation time), so
  // we track the Checkout Session, PaymentIntent, and Charge ids
  // separately rather than assuming one implies the others exist yet.
  stripeCheckoutSessionId  String? @unique
  stripePaymentIntentId    String? @unique
  stripeChargeId           String?
  // Key we generate and pass to Stripe on Checkout Session creation so a
  // client retry (e.g. double-click, network blip) can never create two
  // Stripe sessions/PaymentIntents for the same order.
  idempotencyKey           String? @unique
  status                   PaymentStatus @default(CREATED)
  amountCents              Int
  currency                 String  @default("nzd")
  receiptUrl               String?
  failureReason            String?
  refundedAmountCents      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Mirrors Stripe's own account.updated capability flags into a simple
// status a seller/admin can read at a glance, rather than everyone having
// to interpret raw Stripe requirement codes.
enum PayoutAccountStatus {
  NOT_STARTED
  ONBOARDING_INCOMPLETE
  VERIFICATION_PENDING
  ENABLED
  RESTRICTED
  DISABLED
}

model SellerPayoutAccount {
  id                     String  @id @default(cuid())
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String  @unique
  stripeConnectAccountId String? @unique
  status                 PayoutAccountStatus @default(NOT_STARTED)
  chargesEnabled         Boolean @default(false)
  payoutsEnabled         Boolean @default(false)
  detailsSubmitted       Boolean @default(false)
  // Stripe's `requirements.currently_due` / `past_due` codes, kept as
  // strings for display ("individual.verification.document", etc.) — not
  // parsed further, just surfaced to the seller/admin.
  requirementsCurrentlyDue String[]
  requirementsPastDue      String[]
  disabledReason         String?
  reserveBalanceCents    Int     @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum PayoutStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  ON_HOLD
  REVERSED
}

model Payout {
  id                 String       @id @default(cuid())
  seller             User         @relation(fields: [sellerId], references: [id])
  sellerId           String
  orderItemIds       String[]
  amountCents        Int
  status             PayoutStatus @default(NOT_ELIGIBLE)
  transfer           Transfer?
  idempotencyKey     String?      @unique
  scheduledFor       DateTime?
  paidAt             DateTime?
  failureReason      String?
  // True when an admin manually released this payout rather than the
  // automatic eligibility sweep — required above PlatformFeeSetting's
  // maxAutoPayoutCents, or whenever autoPayoutEnabled is off.
  releasedManuallyBy String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([sellerId])
  @@index([status])
}

// A single Stripe Transfer moving a seller's net proceeds from the
// platform's Stripe balance to their connected account — the mechanism
// that actually implements "delayed seller payout" under the separate
// charges-and-transfers model. One Transfer per Payout.
enum TransferStatus {
  PENDING
  PAID
  REVERSED
  PARTIALLY_REVERSED
  FAILED
}

model Transfer {
  id               String         @id @default(cuid())
  order            Order          @relation(fields: [orderId], references: [id])
  orderId          String
  seller           User           @relation(fields: [sellerId], references: [id])
  sellerId         String
  payout           Payout?        @relation(fields: [payoutId], references: [id])
  payoutId         String?        @unique
  stripeTransferId String?        @unique
  amountCents      Int
  reversedCents    Int            @default(0)
  status           TransferStatus @default(PENDING)
  idempotencyKey   String         @unique
  failureReason    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([sellerId])
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  DENIED
  FAILED
}

enum RefundType {
  FULL
  PARTIAL
  SHIPPING_ONLY
}

model Refund {
  id            String       @id @default(cuid())
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  amountCents   Int
  // How much of `amountCents` was platform commission we're giving back
  // (vs. seller proceeds) — informational, used when explaining the
  // breakdown to the seller and when computing transfer reversal amounts.
  platformFeeRefundCents Int  @default(0)
  reason        String
  type          RefundType   @default(FULL)
  isPartial     Boolean      @default(false)
  status        RefundStatus @default(PENDING)
  stripeRefundId String?     @unique
  // Set if this refund required reversing a Transfer that had already been
  // sent to the seller (post-payout refund) — see lib/payouts.ts.
  reversedTransferId String?
  idempotencyKey String?     @unique
  processedBy   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orderId])
}

enum DisputeStatus {
  OPEN
  SELLER_RESPONSE_REQUIRED
  UNDER_REVIEW
  WAITING_FOR_EVIDENCE
  RESOLVED_BUYER
  RESOLVED_SELLER
  PARTIAL_REFUND
  CLOSED
}

enum DisputeSource {
  BUYER
  STRIPE_CHARGEBACK
}

model Dispute {
  id          String        @id @default(cuid())
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String        @unique
  filedBy     User          @relation("DisputeFiledBy", fields: [filedById], references: [id])
  filedById   String
  source      DisputeSource @default(BUYER)
  reason      String
  description String        @db.Text
  status      DisputeStatus @default(OPEN)

  // Populated only when `source` is STRIPE_CHARGEBACK (charge.dispute.*
  // webhook) rather than a buyer-filed in-app dispute.
  stripeDisputeId   String?   @unique
  evidenceDueBy     DateTime?

  // Opening a dispute immediately blocks the payout-eligibility sweep —
  // see lib/payouts.ts isPayoutEligible(). Always true while OPEN/
  // SELLER_RESPONSE_REQUIRED/UNDER_REVIEW/WAITING_FOR_EVIDENCE.
  payoutOnHold      Boolean   @default(true)

  sellerRespondedAt DateTime?
  sellerResponse    String?   @db.Text

  resolutionNotes String?   @db.Text
  // Internal-only notes, never shown to buyer/seller (vs. resolutionNotes
  // which may be shared as the customer-facing explanation).
  internalNotes   String?   @db.Text
  refundDecisionCents Int?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  evidence DisputeEvidence[]

  @@index([status])
}

model DisputeEvidence {
  id         String   @id @default(cuid())
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  disputeId  String
  uploadedBy String
  url        String
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([disputeId])
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

enum ShipmentStatus {
  AWAITING_TRACKING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model ShippingRecord {
  id             String         @id @default(cuid())
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String         @unique
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  hasInsurance   Boolean        @default(false)
  status         ShipmentStatus @default(AWAITING_TRACKING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Listing reservations (checkout race-condition protection)
// ---------------------------------------------------------------------------

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

// Created the instant a buyer starts checkout; atomically increments
// Listing.reservedQuantity via a guarded raw UPDATE (see
// lib/reservations.ts) so two buyers can never both reserve the last unit
// of a one-of-one item. Consumed (-> listing.quantity actually decremented,
// status SOLD if it hits 0) on confirmed payment; released back on
// checkout failure/expiry by the cleanup sweep.
model ListingReservation {
  id         String            @id @default(cuid())
  listing    Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?           @unique
  buyerId    String
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([listingId, status])
  @@index([status, expiresAt])
}

// ---------------------------------------------------------------------------
// Stripe webhook idempotency
// ---------------------------------------------------------------------------

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

// Primary key IS the Stripe event id (evt_...), so a duplicate delivery of
// the same event is rejected by a unique-constraint violation before any
// business logic runs — the cheapest possible idempotency guarantee.
model WebhookEvent {
  id          String              @id
  type        String
  status      WebhookEventStatus  @default(RECEIVED)
  payload     Json
  error       String?
  attempts    Int                 @default(1)
  receivedAt  DateTime            @default(now())
  processedAt DateTime?

  @@index([type])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorId   String
  subject    User     @relation("ReviewSubject", fields: [subjectId], references: [id])
  subjectId  String
  rating     Int // 1-5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([subjectId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Favorites / Follows
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model FavoriteSeller {
  id         String   @id @default(cuid())
  follower   User     @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String
  seller     User     @relation("FollowedSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId   String
  createdAt  DateTime @default(now())

  @@unique([followerId, sellerId])
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model Conversation {
  id             String   @id @default(cuid())
  participantA   User     @relation("ParticipantA", fields: [participantAId], references: [id])
  participantAId String
  participantB   User     @relation("ParticipantB", fields: [participantBId], references: [id])
  participantBId String
  listingRefId   String?
  isBlocked      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]

  @@unique([participantAId, participantBId, listingRefId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  senderId       String
  listingRef     Listing?     @relation("MessageListingRef", fields: [listingRefId], references: [id])
  listingRefId   String?
  body           String       @db.Text
  isRead         Boolean      @default(false)
  isFlagged      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model UserBlock {
  id          String   @id @default(cuid())
  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId   String
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId   String
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  ORDER_UPDATE
  MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  VERIFICATION_UPDATE
  PAYOUT
  DISPUTE
  STRIPE_ACCOUNT
  REVIEW
  SYSTEM
}

model Notification {
  id        String            @id @default(cuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// Reports / Trust & Safety
// ---------------------------------------------------------------------------

enum ReportReason {
  COUNTERFEIT
  FRAUD
  PROHIBITED_ITEM
  MISLEADING_LISTING
  HARASSMENT
  SPAM
  PAYMENT_BYPASS_ATTEMPT
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

model Report {
  id             String       @id @default(cuid())
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  reporterId     String
  reportedUser   User?        @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  reportedUserId String?
  listing        Listing?     @relation("ReportedListing", fields: [listingId], references: [id])
  listingId      String?
  reason         ReportReason
  details        String       @db.Text
  status         ReportStatus @default(OPEN)
  resolutionNotes String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit Logs / Platform Settings
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorId    String?
  action     String // "listing.approve", "user.ban", "verification.review", ...
  targetType String // "Listing" | "User" | "Order" | ...
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ---------------------------------------------------------------------------
// AI Support Chatbot
// ---------------------------------------------------------------------------
// Named Ai* to avoid colliding with the buyer<->seller Conversation/Message
// models above. Persisted only for logged-in users — anonymous chat sessions
// are not saved (see lib/ai/).

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String?
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           AiMessageRole
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}
