# Copy to .env.local and fill in. Leave the Supabase pair unset to run PyWots
# open and local-only (no sign-in, no access check): fine for development.
# With them set, PyWots needs an account + a redeemed access code.
# Full setup: supabase/README.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Etsy listing, for "Get 12 months on Etsy" links (hidden while empty).
VITE_ETSY_LISTING_URL=
# Sign-in buttons to show besides email, once enabled in Supabase: google,apple
VITE_OAUTH_PROVIDERS=
# Public site the native app links to for /claim (default https://pywots.vercel.app).
VITE_SITE_URL=
